{
  "name": "dsh-memory-bridge-profile",
  "version": "0.18.17",
  "description": "DSH Memory plugin for existing workspaces and conversations, connected to company intranet memory services.",
  "type": "module",
  "main": "./index.js",
  "icon": "./assets/icon.webp",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./assets/icon.webp",
    "./memory-client": "./src/memory-client.js",
    "./episode": "./src/episode.js",
    "./group-config": "./src/group-config.js",
    "./trace": "./src/trace.js",
    "./receipt-marker": "./src/receipt-marker.js",
    "./session-events": "./src/session-events.js",
    "./config": "./src/config.js",
    "./web-api": "./src/web-api.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "files": [
    "index.js",
    "client.js",
    "src/**/*.js",
    "static/*",
    "assets/icon.webp",
    "cordis.patch.yml",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "check": "node --check index.js && node --check client.js && node --check src/config.js && node --check src/group-config.js && node --check src/memory-client.js && node --check src/episode.js && node --check src/receipt-marker.js && node --check src/session-events.js && node --check src/trace.js && node --check src/web-api.js && node --check src/workspaces.js && node --check src/auto-join.js && node --check src/workbench-api.js && node --check static/workbench.js && node --check static/account.js && node --check src/dsh-catalog.js && node --check src/history-uploads.js && node --check src/diagnostics.js && node --check src/processing.js && node --check src/evolith-runtime.js && node --check src/evolith-window.js && node --check src/evolith-consent.js && node --check src/verified-memory.js",
    "test": "./scripts/test.sh",
    "test:unit": "./scripts/test.sh --unit",
    "test:bizagent": "./scripts/test.sh --bizagent",
    "test:all": "./scripts/test.sh"
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": "0.2.0-rc.2 || 0.2.1-rc.2 || 0.2.2-alpha.2 || 0.2.2-rc.1"
  },
  "license": "UNLICENSED",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.2.0-rc.2 || ^0.2.1-rc.2 || 0.2.2-alpha.2 || 0.2.2-rc.1",
    "@deepseek-ai/dsh-commands": "^0.2.0-rc.2 || ^0.2.1-rc.2 || 0.2.2-alpha.2 || 0.2.2-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.2.0-rc.2 || ^0.2.1-rc.2 || 0.2.2-alpha.2 || 0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.2 || ^0.2.1-rc.2 || 0.2.2-alpha.2 || 0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "^0.2.0-rc.2 || ^0.2.1-rc.2 || 0.2.2-alpha.2 || 0.2.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "^0.2.0-rc.2 || ^0.2.1-rc.2 || 0.2.2-alpha.2 || 0.2.2-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-host-webserver": {
      "optional": true
    }
  },
  "author": "a3306037618-byte",
  "keywords": [
    "dsh-plugin",
